# Copy this file to .env and fill in your values
# DO NOT commit the actual .env file to git

MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/insta-clone
JWT_SECRET=your_jwt_secret_here

IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key_here

GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# For local dev:
# GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
# For Render production:
# GOOGLE_CALLBACK_URL=https://YOUR-BACKEND-NAME.onrender.com/auth/google/callback

GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Your deployed frontend URL (set this in Render dashboard, not here)
# FRONTEND_URL=https://YOUR-FRONTEND-NAME.onrender.com
